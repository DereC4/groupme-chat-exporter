/**
 * GroupMe Chat Exporter
 * Run this snippet in your browser's Developer Tools Console.
 * Ensure you are logged into GroupMe on the web.
 */
(async function () {
  "use strict";

  // Configuration
  const CONFIG = {
    groupId: "YOUR_GROUP_ID_HERE",
    accessToken: "YOUR_ACCESS_TOKEN_HERE",
    batchLimit: 100,
    throttleMs: 350,
    apiUrl: "https://api.groupme.com/v3"
  };

  /**
   * Pauses execution for a given number of milliseconds.
   * @param {number} ms - Milliseconds to sleep.
   * @returns {Promise<void>}
   */
  const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

  /**
   * Triggers a browser download of a JSON object.
   * @param {Array<Object>} data - The array of message objects.
   * @param {string} filename - The desired output filename.
   */
  const triggerDownload = (data, filename) => {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    
    anchor.href = url;
    anchor.download = filename;
    
    document.body.appendChild(anchor);
    anchor.click();
    
    document.body.removeChild(anchor);
    URL.revokeObjectURL(url);
  };

  /**
   * Fetches a single batch of messages from the GroupMe API.
   * @param {string} beforeId - The ID of the oldest message currently fetched.
   * @returns {Promise<Array<Object>|null>} Array of messages, or null if the beginning is reached.
   */
  const fetchMessageBatch = async (beforeId) => {
    const url = new URL(`${CONFIG.apiUrl}/groups/${CONFIG.groupId}/messages`);
    url.searchParams.append("limit", CONFIG.batchLimit.toString());
    
    if (beforeId) {
      url.searchParams.append("before_id", beforeId);
    }

    const response = await fetch(url.toString(), {
      method: "GET",
      headers: {
        "X-Access-Token": CONFIG.accessToken,
        "Content-Type": "application/json"
      }
    });

    if (response.status === 304) {
      return null;
    }

    if (!response.ok) {
      throw new Error(`API returned HTTP ${response.status}: ${response.statusText}`);
    }

    const json = await response.json();
    return json.response?.messages || [];
  };

  // Main Execution
  const exportChat = async () => {
    if (CONFIG.groupId.includes("YOUR_") || CONFIG.accessToken.includes("YOUR_")) {
      console.error("Error: Please update CONFIG.groupId and CONFIG.accessToken before running.");
      return;
    }

    console.log("%cStarting GroupMe chat export...", "color: #00aff0; font-weight: bold; font-size: 14px;");

    const allMessages = [];
    let beforeId = "";
    let page = 1;

    try {
      while (true) {
        const messages = await fetchMessageBatch(beforeId);

        if (messages === null || messages.length === 0) {
          console.log("%cReached the very beginning of the chat history.", "color: #28a745; font-weight: bold;");
          break;
        }

        allMessages.push(...messages);
        beforeId = messages[messages.length - 1].id;
        
        console.log(`Batch ${page}: Fetched ${messages.length} messages (Total collected: ${allMessages.length})`);
        page++;

        await sleep(CONFIG.throttleMs);
      }

      if (allMessages.length > 0) {
        allMessages.reverse();
        
        const filename = `groupme_${CONFIG.groupId}_export.json`;
        triggerDownload(allMessages, filename);
        
        console.log(`%cSuccessfully saved ${allMessages.length} messages to ${filename}`, "color: #28a745; font-weight: bold; font-size: 14px;");
      } else {
        console.warn("No messages were found for this group.");
      }

    } catch (error) {
      console.error("An error occurred during export:", error.message);
    }
  };

  await exportChat();
})();
